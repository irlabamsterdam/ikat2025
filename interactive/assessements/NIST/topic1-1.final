        "response": {
          "rank": 1,
          "user_utterance": "Oh, got it! So melons are good? I really like watermelon, so that\u2019s awesome. Any other fruits besides banana and melon that are gentle on reflux?",
          "user_rubrik": "What are some fruits good for acid reflux?",
          "user_rubrik_score": 5,

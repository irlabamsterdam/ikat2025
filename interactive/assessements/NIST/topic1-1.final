          "ptkb_provenance": [
            "1. I have gained weight recently because I stopped exercising for the last 6 months.",
            "2. I want to change my lifestyle.",
            "3. I eat dinner late at night.",
            "4. I eat out regularly.",
            "5. I like my local pizzeria."

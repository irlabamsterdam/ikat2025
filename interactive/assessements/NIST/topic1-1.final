    "responses": [
      {
        "turn": 4,
        "response": {
          "rank": 1,
          "user_utterance": "Thanks, that\u2019s reassuring. I like apples, kiwi, and watermelon, so I\u2019ve got good options! Are there any specific drinks I should stay away from if I\u2019m prone to reflux?",
          "user_rubrik": "What are some good habits to help someone with stomach acid reflux?",

    "responses": [
      {
        "turn": 1,
        "response": {
          "rank": 1,
          "user_utterance": "I'm looking for information on managing ADHD, especially at work. What are some common strategies people use?",
          "user_rubrik": "How can ADHD be managed?",
          "user_rubrik_score": 2,
          "text": "Individuals with ADHD can cope with their symptoms at work by using simple strategies and accommodations. Some common strategies include using headphones to block out distractions, maintaining an organized space, keeping notes, and avoiding over-scheduling. These",
          "citations": {
            "clueweb22-en0019-85-03855:10": 4.615283012390137,
            "clueweb22-en0008-79-03771:5": 2.936486005783081,

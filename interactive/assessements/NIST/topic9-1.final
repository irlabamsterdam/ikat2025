            "clueweb22-en0043-57-01365:6": 0.8337506055831909,
            "clueweb22-en0002-05-13020:10": 0.7816482782363892,
            "clueweb22-en0002-05-13020:7": 0.6901335120201111,
            "clueweb22-en0002-05-13020:4": 0.6072414517402649,
            "clueweb22-en0022-69-13272:10": 0.5279781818389893,
            "clueweb22-en0043-57-01365:8": 0.40057986974716187,
            "clueweb22-en0002-05-13020:5": 0.38943207263946533,

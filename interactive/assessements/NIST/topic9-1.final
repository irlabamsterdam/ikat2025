            "clueweb22-en0004-58-12409:15": -0.05976448580622673,
            "clueweb22-en0020-10-04236:3": -0.0658622607588768,
            "clueweb22-en0032-51-05035:17": -0.0905858501791954,
            "clueweb22-en0032-51-05035:16": -0.09932641685009003,
            "clueweb22-en0020-92-06373:4": -0.09977878630161285,

    "responses": [
      {
        "turn": 1,
        "response": {
          "rank": 1,
          "user_utterance": "I\u2019m looking to learn more about what to check or upgrade first on a second-hand bike. What should I focus on?",
          "user_rubrik": "What are the most important parts to inspect and upgrade first on a second-hand bike?",
          "user_rubrik_score": 2,
          "text": "To determine if your bike's suspension is any good, check for any signs of wear, such",
          "citations": {},

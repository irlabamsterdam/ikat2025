    "responses": [
      {
        "turn": 1,
        "response": {
          "rank": 1,
          "user_utterance": "I'm interested in learning how to tell different finger injuries apart. What are the main types?",
          "user_rubrik": "How can I distinguish different finger injuries?",
          "user_rubrik_score": 2,
          "text": "Pulley injuries typically occur when the tendons or ligaments in the fingers are stretched or torn, often due to overuse or sudden strain. Symptoms may include pain, swelling, and bruising in the affected finger, particularly when bending or straightening the finger. You may also experience a sensation of \"catching\"",
          "citations": {},

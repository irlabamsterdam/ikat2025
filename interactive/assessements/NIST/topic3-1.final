  {
    "runtag": "genaius-summary-rewrite",
    "type": "ikat-fragment-v1",
    "topic": "3-1",
    "responses": [
      {
        "turn": 4,
        "response": {
          "rank": 1,
          "user_utterance": "That\u2019s clear. What kinds of long-term issues might happen if I don\u2019t give my finger enough time to heal before climbing again?",
          "user_rubrik": "What are the risk if I continue climbing and don\u2019t rest with my injury at the front of my finger?",
          "user_rubrik_score": 5,
          "text": "If you resume climbing before your finger has fully healed, you risk developing chronic issues that could significantly impact your climbing. Long-term problems may include persistent pain, reduced grip strength, and limited range of motion in the injured finger. Additionally, the injury could worsen, leading to a complete rupture of the pulley, which might require surgical intervention and a much longer recovery period. Over time, insufficient healing can also lead to compensatory injuries in other fingers or joints as your body tries to adapt to the weakened area. To avoid these outcomes, it\u2019s crucial to allow adequate time for recovery and follow a structured rehabilitation plan.",
          "citations": {
            "clueweb22-en0017-96-08323:0": 32.338401794433594,
            "clueweb22-en0007-15-09796:1": 32.2963981628418,

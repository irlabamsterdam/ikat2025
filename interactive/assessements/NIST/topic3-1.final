            "clueweb22-en0037-51-18167:7": -3.031447649002075,
            "clueweb22-en0007-15-09796:3": -4.580768585205078,
            "clueweb22-en0033-77-05923:0": -4.708033084869385
          },
          "ptkb_provenance": []
        }

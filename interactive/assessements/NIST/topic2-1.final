      {
        "turn": 1,
        "response": {
          "rank": 1,
          "user_utterance": "Hi, I want to know how to make really good coffee. What should I start with?",
          "user_rubrik": "How to make a good coffee?",
          "user_rubrik_score": 2,
          "text": "As a developer, coffee can be beneficial to your work as it can help increase alertness,",
          "citations": {
            "clueweb22-en0002-23-18110:2": 3.3851938247680664,
            "clueweb22-en0007-45-08253:7": 2.3223438262939453,

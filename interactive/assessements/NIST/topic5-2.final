      {
        "turn": 9,
        "response": {
          "rank": 1,
          "user_utterance": "That makes sense. Are there specific lower-carb foods or snacks that are known to support good milk supply, maybe with extra protein or nutrients? I definitely prefer foods that are filling and nourishing.",
          "user_rubrik": "Do I need to change my diet when breastfeeding?",
          "user_rubrik_score": 3,

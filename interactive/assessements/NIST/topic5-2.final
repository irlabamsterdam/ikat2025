    "responses": [
      {
        "turn": 1,
        "response": {
          "rank": 1,
          "user_utterance": "I want to know\u2014can breastfeeding ever be bad for the baby?",
          "user_rubrik": "Is breastfeeding bad for the baby?",
          "user_rubrik_score": 5,
          "text": "",

          "ptkb_provenance": [
            "1. The user has acid reflux or is concerned about it.",
            "2. I have gained weight recently because I stopped exercising for the last 6 months.",
            "3. The user believes their recent weight gain from stopping exercise might be contributing to their acid reflux.",
            "4. I want to increase my protein intake.",
            "5. I eat out regularly.",
            "6. I want to change my lifestyle.",
            "7. User is actively seeking guidance to initiate a healthier and more active lifestyle.",
            "8. I eat dinner late at night.",
            "9. The user is actively trying to change their evening routines.",
            "10. I like my local pizzeria."

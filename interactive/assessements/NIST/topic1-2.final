    "responses": [
      {
        "turn": 1,
        "response": {
          "rank": 1,
          "user_utterance": "I\u2019m curious about how I can start having a healthier and more active lifestyle. Where should I begin?",
          "user_rubrik": "How to get started to have a healthier and more active lifestyle?",
          "user_rubrik_score": 3,
          "text": "To reduce your weight and maintain a healthy lifestyle, focus on making sustainable changes. Start by being more mindful of your eating habits, such as avoiding late-night dinners and choosing whole, nutrient-dense foods. Incorporate physical activity",
          "citations": {
            "clueweb22-en0004-20-10402:4": 3.3284807205200195,
            "clueweb22-en0004-41-11260:12": 3.2201249599456787,
            "clueweb22-en0017-72-14196:3": 3.048922061920166,

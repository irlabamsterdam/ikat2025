          "ptkb_provenance": [
            "1. I have gained weight recently because I stopped exercising for the last 6 months.",
            "2. I\u2019m concerned about acid reflux.",
            "3. I want to increase my protein intake.",
            "4. I eat out regularly.",
            "5. I eat dinner late at night.",
            "6. - Seeks to understand the underlying causes/mechanisms of health conditions (e.g., acid reflux)",
            "7. - Seeks medication-based solutions for acid reflux.",
            "8. - Seeks over-the-counter (OTC) medication solutions.",
            "9. - Seeks to understand the mechanism of action for medications."
          ]
        }

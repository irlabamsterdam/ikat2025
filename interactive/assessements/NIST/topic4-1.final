            "clueweb22-en0035-40-13882:0": 41.258399963378906,
            "clueweb22-en0023-74-13192:4": 40.880401611328125
          },
          "ptkb_provenance": []
        }
      },
      {
        "turn": 7,
        "response": {
          "rank": 1,
